---
// src/components/Proximamente.astro
interface Props {
  titulo?: string;
  texto?: string;
}

const { 
  titulo = "CALENTANDO MOTORES", 
  texto = "Esta sección va a estar disponible muy pronto." 
} = Astro.props;
---

<div class="cartel-proximamente">
  <svg class="icono-construccion" viewBox="0 0 24 24" width="80" height="80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
  </svg>
  
  <h2>{titulo}</h2>
  <p>{texto}</p>
  <span class="sub-proximamente">Seguinos en redes para enterarte antes que nadie.</span>
  
  <a href="/" class="btn-volver">← Volver al inicio</a>
</div>

<style>
  .cartel-proximamente {
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 60px 20px;
    text-align: center;
    max-width: 700px;
    margin: 40px auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    font-family: 'Inter', sans-serif;
  }

  .icono-construccion {
    color: #e50914; 
    margin-bottom: 20px;
    animation: flotar 3s ease-in-out infinite;
  }

  .cartel-proximamente h2 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 2.2rem;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .cartel-proximamente p {
    font-size: 1.1rem;
    color: #cccccc;
    margin-bottom: 5px;
  }

  .sub-proximamente {
    display: block;
    font-size: 0.9rem;
    color: #777777;
    margin-bottom: 30px;
  }

  .btn-volver {
    display: inline-block;
    padding: 10px 25px;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 5px;
    text-decoration: none;
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .btn-volver:hover {
    background-color: #ffffff;
    color: #000000;
  }

  @keyframes flotar {
    0% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0); }
  }
</style>