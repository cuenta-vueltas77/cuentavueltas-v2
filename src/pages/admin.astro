---

// src/pages/admin.astro
import BaseLayout from "../layouts/BaseLayout.astro";

// 🛑 ASTRO DB DESACTIVADO TEMPORALMENTE HASTA CONECTAR TURSO (FASE 2) 🛑
// Dejamos las variables vacías para que el diseño no se rompa en Vercel
const categoriasDB = [];
const notasDB = [];
const totalVotos = 0;
const resultadosOrdenados = [];

---

<BaseLayout titulo="Centro de Mando - Admin">
  <main class="admin-contenedor">
    <!-- 1. PANTALLA DE ACCESO (LOGIN) -->
    <div id="pantalla-login" class="login-caja">
      <h2>Acceso Admin</h2>
      <p>Ingresá tu contraseña para gestionar Cuenta Vueltas 77</p>
      <form id="form-login">
        <input 
          type="password" 
          id="input-pass" 
          placeholder="Contraseña..." 
          required 
        />
        <button type="submit" class="btn-rojo">Ingresar</button>
      </form>
      <p id="error-login" class="error-texto oculto">Contraseña incorrecta.</p>
    </div>

    <!-- 2. PANEL PRINCIPAL -->
    <div id="panel-admin" class="oculto">
      <header class="admin-header">
        <h1>Centro de Mando</h1>
        <button id="btn-salir" class="btn-secundario">Cerrar Sesión</button>
      </header>

      <div class="opciones-grilla" id="menu-principal">
        <!-- TARJETA 1: REDACTOR (LLEVA A DECAP CMS) -->
        <div class="opcion-card" id="card-redactor">
          <div class="opcion-icono">📝</div>
          <h3>Redactor de Notas</h3>
          <p>Escribí y formateá artículos para la web de forma rápida.</p>
          <a href="/panel-noticias" class="btn-rojo" style="text-decoration: none; display: inline-block;">Nueva Nota</a>
        </div>

        <!-- TARJETA 2: GESTOR DE NOTAS (LLEVA A DECAP CMS) -->
        <div class="opcion-card" id="card-gestor-notas">
          <div class="opcion-icono">📚</div>
          <h3>Gestor de Notas</h3>
          <p>Revisá tus notas publicadas, editá su contenido o borralas de la base de datos.</p>
          <a href="/panel-noticias" class="btn-rojo" style="text-decoration: none; display: inline-block;">Ver Mis Notas</a>
        </div>

        <!-- TARJETA 3: PILOTO DE LA FECHA -->
        <div class="opcion-card" id="card-gestor-votos">
          <div class="opcion-icono">🏎️</div>
          <h3>Piloto de la Fecha</h3>
          <p>Editá los candidatos de la fecha y revisá los gráficos de votos.</p>
          <button class="btn-rojo">Gestionar Votación</button>
        </div>
      </div>

      <!-- 3. MÓDULO: GESTIÓN DE NOTAS (OCULTO COMO RESPALDO) -->
      <div id="seccion-notas" class="seccion-modulo oculto">
        <div class="modulo-header">
          <button id="btn-volver-notas" class="btn-secundario">← Volver al Menú</button>
          <h2>Gestión de Notas (Astro DB)</h2>
        </div>

        {notasDB.length === 0 ? (
          <p class="bajada-tab">Todavía no hay notas guardadas en Astro DB.</p>
        ) : (
          <div class="lista-notas-tabla">
            {notasDB.map((nota) => (
              <div class="nota-admin-row" data-id={nota.id}>
                <div class="nota-admin-info">
                  <h4>{nota.titulo}</h4>
                  <span>Categoría: <b>{nota.categorias}</b> | Autor: {nota.autor || "Redacción CV77"}</span>
                </div>
                <div class="nota-admin-botones">
                  <a href={`/admin/redactor?id=${nota.id}`} class="btn-editar">✏️ Editar</a>
                  <button class="btn-borrar btn-borrar-nota" data-id={nota.id}>🗑️ Borrar</button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- 4. MÓDULO: GESTOR DE VOTOS -->
      <div id="seccion-votos" class="seccion-modulo oculto">
        <div class="modulo-header">
          <button id="btn-volver-menu" class="btn-secundario">← Volver al Menú</button>
          <h2>Gestión: Piloto de la Fecha</h2>
        </div>

        <div class="pestanas-nav">
          <button class="pestana-btn activa" data-tab="tab-nombres">✏️ Editar Nombres</button>
          <button class="pestana-btn" data-tab="tab-graficos">📊 Ver Resultados</button>
        </div>

        <div id="tab-nombres" class="pestana-contenido">
          <p class="bajada-tab">Modificá los nombres de los 4 candidatos por categoría y guardá los cambios para actualizar la web en vivo:</p>
          
          <form id="form-editar-candidatos" class="form-categorias">
            {categoriasDB.map((cat) => (
              <div class="cat-admin-box" data-id={cat.id}>
                <h4>{cat.nombre} ({cat.siglas})</h4>
                <div class="inputs-grid">
                  <input type="text" value={cat.candidatos[0] || ""} placeholder="Piloto 1" />
                  <input type="text" value={cat.candidatos[1] || ""} placeholder="Piloto 2" />
                  <input type="text" value={cat.candidatos[2] || ""} placeholder="Piloto 3" />
                  <input type="text" value={cat.candidatos[3] || ""} placeholder="Piloto 4" />
                </div>
              </div>
            ))}

            <button type="submit" class="btn-rojo btn-guardar-todo">💾 Guardar Cambios en la Web</button>
          </form>
        </div>

        <div id="tab-graficos" class="pestana-contenido oculto">
          <p class="bajada-tab">Estadísticas en vivo de la fecha actual generadas desde Astro DB:</p>
          
          <div class="grafico-caja">
            <h4>Total general de votos: {totalVotos}</h4>

            {resultadosOrdenados.length === 0 ? (
              <p class="bajada-tab" style="margin-top: 1rem;">Todavía no se registraron votos en la base de datos.</p>
            ) : (
              resultadosOrdenados.map((item) => (
                <div class="barra-item">
                  <div class="barra-info">
                    <span>{item.piloto}</span>
                    <span>{item.porcentaje}% ({item.votos} {item.votos === 1 ? 'voto' : 'votos'})</span>
                  </div>
                  <div class="barra-fondo">
                    <div class="barra-progreso" style={`width: ${item.porcentaje}%;`}></div>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const CLAVE_ADMIN = "cv77admin";

  const formLogin = document.getElementById("form-login") as HTMLFormElement;
  const inputPass = document.getElementById("input-pass") as HTMLInputElement;
  const errorLogin = document.getElementById("error-login");
  const pantallaLogin = document.getElementById("pantalla-login");
  const panelAdmin = document.getElementById("panel-admin");
  const btnSalir = document.getElementById("btn-salir");

  const menuPrincipal = document.getElementById("menu-principal");
  const seccionVotos = document.getElementById("seccion-votos");
  const cardGestorVotos = document.getElementById("card-gestor-votos");
  const btnVolverMenu = document.getElementById("btn-volver-menu");
  
  // Nombramos las tarjetas de notas
  const cardRedactor = document.getElementById("card-redactor");
  const cardGestorNotas = document.getElementById("card-gestor-notas");

  const pestanaBtns = document.querySelectorAll(".pestana-btn");
  const pestanaContenidos = document.querySelectorAll(".pestana-contenido");

  // Login
  formLogin?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (inputPass.value === CLAVE_ADMIN) {
      pantallaLogin?.classList.add("oculto");
      panelAdmin?.classList.remove("oculto");
      errorLogin?.classList.add("oculto");
    } else {
      errorLogin?.classList.remove("oculto");
    }
  });

  btnSalir?.addEventListener("click", () => {
    panelAdmin?.classList.add("oculto");
    pantallaLogin?.classList.remove("oculto");
    inputPass.value = "";
  });

  // 👇 ACÁ ESTÁ LA MAGIA NUEVA: Llevamos las dos tarjetas a Decap CMS
  cardRedactor?.addEventListener("click", () => {
    window.location.href = "/panel-noticias";
  });

  cardGestorNotas?.addEventListener("click", () => {
    window.location.href = "/panel-noticias";
  });

  // Navegación Votos
  cardGestorVotos?.addEventListener("click", () => {
    menuPrincipal?.classList.add("oculto");
    seccionVotos?.classList.remove("oculto");
  });

  btnVolverMenu?.addEventListener("click", () => {
    seccionVotos?.classList.add("oculto");
    menuPrincipal?.classList.remove("oculto");
  });

  // Pestañas Pilotos
  pestanaBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      pestanaBtns.forEach((b) => b.classList.remove("activa"));
      pestanaContenidos.forEach((c) => c.classList.add("oculto"));

      btn.classList.add("activa");
      const targetTab = document.getElementById(btn.getAttribute("data-tab") || "");
      targetTab?.classList.remove("oculto");
    });
  });

  // Guardar Candidatos
  const formEditar = document.getElementById("form-editar-candidatos");
  formEditar?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const cajas = document.querySelectorAll(".cat-admin-box");
    const nuevaLista: { id: string; candidatos: string[] }[] = [];

    cajas.forEach((caja) => {
      const id = caja.getAttribute("data-id") || "";
      const inputs = caja.querySelectorAll("input");
      const candidatos = Array.from(inputs).map((input) => input.value.trim());
      nuevaLista.push({ id, candidatos });
    });

    try {
      const res = await fetch("/api/guardar-candidatos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(nuevaLista)
      });
      if (res.ok) {
        alert("¡Candidatos actualizados con éxito en Cuenta Vueltas 77!");
      } else {
        alert("Hubo un problema al guardar los cambios.");
      }
    } catch (error) {
      alert("Error de conexión al guardar.");
    }
  });

</script>

<style>
  .admin-contenedor {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
  }

  .oculto {
    display: none !important;
  }

  .login-caja {
    max-width: 400px;
    margin: 4rem auto;
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  .login-caja h2 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }

  .login-caja p {
    color: #a0a0a0;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .login-caja input {
    width: 100%;
    padding: 0.8rem;
    background: #1f1f1f;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: #fff;
    margin-bottom: 1rem;
    box-sizing: border-box;
  }

  .error-texto {
    color: #e10600 !important;
    margin-top: 1rem !important;
    font-weight: 600;
  }

  .btn-rojo {
    background: #e10600;
    color: #fff;
    border: none;
    padding: 0.8rem 1.5rem;
    border-radius: 4px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-rojo:hover {
    background: #ff1810;
  }

  .btn-secundario {
    background: #222;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .btn-secundario:hover {
    background: #333;
  }

.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: transparent;
  border-bottom: 2px solid rgba(225, 6, 0, 0.45);
  padding-bottom: 1.2rem;
  margin-bottom: 2.5rem;
}
  
  .admin-header h1 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 2.5rem;
    text-transform: uppercase;
    margin: 0;
  }

  .opciones-grilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .opcion-card {
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .opcion-card:hover {
    transform: translateY(-4px);
    border-color: #e10600;
  }

  .opcion-icono {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .opcion-card h3 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }

  .opcion-card p {
    color: #a0a0a0;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .modulo-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .modulo-header h2 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    margin: 0;
  }

  .lista-notas-tabla {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nota-admin-row {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.2rem 1.5rem;
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .nota-admin-info h4 {
    margin: 0 0 0.4rem 0;
    font-size: 1.2rem;
    color: #fff;
  }

  .nota-admin-info span {
    font-size: 0.85rem;
    color: #aaa;
  }

  .nota-admin-botones {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .btn-editar {
    background: #252525;
    color: #fff;
    text-decoration: none;
    padding: 0.6rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn-editar:hover {
    background: #333;
    border-color: #fff;
  }

  .btn-borrar {
    background: #3a0d0d;
    color: #ff6b6b;
    border: 1px solid rgba(255, 0, 0, 0.3);
    padding: 0.6rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .btn-borrar:hover {
    background: #e10600;
    color: #fff;
  }

  .pestanas-nav {
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 2rem;
  }

  .pestana-btn {
    background: transparent;
    border: none;
    color: #a0a0a0;
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }

  .pestana-btn.activa {
    color: #fff;
    border-bottom-color: #e10600;
  }

  .bajada-tab {
    color: #a0a0a0;
    margin-bottom: 2rem;
  }

  .cat-admin-box {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.5rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
  }

  .cat-admin-box h4 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.3rem;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    color: #e10600;
  }

  .inputs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .inputs-grid input {
    background: #1e1e1e;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    color: #fff;
  }

  .btn-guardar-todo {
    width: 100%;
    margin-top: 1rem;
    padding: 1rem;
    font-size: 1.2rem;
  }

  .grafico-caja {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2rem;
    border-radius: 8px;
    max-width: 600px;
  }

  .grafico-caja h4 {
    margin: 0 0 1.5rem 0;
    font-size: 1.1rem;
    color: #a0a0a0;
  }

  .barra-item {
    margin-bottom: 1.2rem;
  }

  .barra-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .barra-fondo {
    width: 100%;
    height: 12px;
    background: #222;
    border-radius: 6px;
    overflow: hidden;
  }

  .barra-progreso {
    height: 100%;
    background: #e10600;
    border-radius: 6px;
  }
</style>