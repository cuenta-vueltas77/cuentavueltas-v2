---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../components/NewsCard.astro";
import Header from "../components/Header.astro";

// 1. Traemos las notas de Markdown (Las que carga tu novia desde Decap CMS)
const notasMD = await getCollection("noticias");

// 2. Armamos la lista con el formato exacto que espera tu NewsCard
const todasLasNotas = notasMD.map((nota) => ({
  id: nota.slug || nota.id,
  data: {
    titulo: nota.data.titulo,
    imagen: nota.data.imagen,
    // Aseguramos que la categoría sea siempre una lista [ "Automovilismo" ]
    categorias: Array.isArray(nota.data.categorias)
      ? nota.data.categorias
      : [nota.data.categorias || "General"],
    tipo: nota.data.tipo || "Noticia",
    // Aseguramos que la fecha se lea correctamente del Frontmatter
    fecha: (nota.data.fecha && !isNaN(new Date(nota.data.fecha).getTime()))
      ? new Date(nota.data.fecha)
      : new Date(),
    // Cubrimos tanto si lo escribiste como mostrarEnInicio o mostrarInicio
    mostrarEnInicio:
      nota.data.mostrarEnInicio !== false && nota.data.mostrarInicio !== false,
  },
}));

// 3. Filtramos las que van al Inicio y ordenamos de más NUEVA a más VIEJA
const noticiasDelInicio = todasLasNotas
  .filter((noticia) => noticia.data.mostrarEnInicio)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<BaseLayout titulo="Inicio">
  <section class="seccion-noticias">
    <div class="seccion-noticias__encabezado">
      <h1>Últimas noticias</h1>
    </div>

    <div class="news-grid">
      {
        noticiasDelInicio.map((noticia) => (
          <NewsCard
            titulo={noticia.data.titulo}
            imagen={noticia.data.imagen}
            categoria={noticia.data.categorias[0]}
            tipo={noticia.data.tipo}
            fecha={noticia.data.fecha}
            url={`/noticias/${noticia.id}`}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>