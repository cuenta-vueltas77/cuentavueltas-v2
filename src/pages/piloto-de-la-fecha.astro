---
// src/pages/piloto-de-la-fecha.astro
import BaseLayout from "../layouts/BaseLayout.astro";

// 👇 ACÁ EDITÁS LOS PILOTOS CADA FIN DE SEMANA SÚPER FÁCIL
const categorias = [
  {
    id: "tc_austral",
    siglas: "TCA",
    nombre: "TC Austral",
    candidatos: ["Miguel Otero", "Sergio Larreguy", "Javier Hernandez"],
  },
  {
    id: "tp_1100",
    siglas: "1100",
    nombre: "TP 1100",
    candidatos: ["Walter Jones", "Santiago Villar","Leonardo Carrion"],
  },
  {
    id: "r12",
    siglas: "R12",
    nombre: "Monomarca R12",
    candidatos: ["Abel Panquilto", "Gian Franco Mesiti", "Javier Casas"],
  },
  {
    id: "tc_patagonico",
    siglas: "TCP",
    nombre: "TC Patagónico",
    candidatos: ["Axel Oliver", "Emiliano Lopez", "Marcos Laudonio"], 
  },
  {
    id: "tp_gol",
    siglas: "GOL",
    nombre: "TP Gol",
    candidatos: ["Benjamin Conti", "Arian Gomez", "Fabian Lopez"], 
  }
];
---

<BaseLayout titulo="Piloto de la Fecha">
  <main class="piloto-contenedor">
    <div class="piloto-header">
      <h1>Piloto de la Fecha</h1>
      <p>Votá al piloto más destacado del fin de semana en cada categoría.</p>
    </div>

    <div class="categorias-grilla">
      {categorias.map((cat) => (
        <div class="categoria-card">
          <div class="casco-contenedor">
            <div class="casco-grafico">
              <span class="siglas-cat">{cat.siglas}</span>
            </div>
          </div>

          <div class="categoria-info">
            <h3>{cat.nombre}</h3>
            <p class="subtitulo">Votación abierta</p>
            <button 
              class="btn-votar" 
              data-id={cat.id}
              data-nombre={cat.nombre}
              data-candidatos={JSON.stringify(cat.candidatos)}
            >
              Votar
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- MODAL DE VOTACIÓN -->
    <div id="modal-votacion" class="modal-overlay oculto">
      <div class="modal-caja">
        <button id="btn-cerrar-modal" class="modal-cerrar">✕</button>
        <h2 id="modal-titulo">Votar en Categoría</h2>
        <p class="modal-bajada">Elegí un candidato o escribí otro piloto:</p>

        <form id="form-voto">
          <input type="hidden" id="input-categoria" name="categoria" value="" />
          
          <div id="lista-candidatos" class="candidatos-opciones"></div>

          <label class="opcion-radio otro-label">
            <input type="radio" name="piloto" value="OTRO" id="radio-otro" />
            <span>Otro:</span>
            <input type="text" id="input-otro-nombre" placeholder="Escribí nombre y apellido..." disabled />
          </label>

          <button type="submit" class="btn-enviar-voto">Enviar Voto</button>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const botonesVotar = document.querySelectorAll('.btn-votar');
  const modal = document.getElementById('modal-votacion');
  const btnCerrar = document.getElementById('btn-cerrar-modal');
  const modalTitulo = document.getElementById('modal-titulo');
  const inputCategoria = document.getElementById('input-categoria') as HTMLInputElement;
  const listaCandidatos = document.getElementById('lista-candidatos');
  const radioOtro = document.getElementById('radio-otro') as HTMLInputElement;
  const inputOtroNombre = document.getElementById('input-otro-nombre') as HTMLInputElement;
  const formVoto = document.getElementById('form-voto') as HTMLFormElement;

  botonesVotar.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nombreCat = btn.getAttribute('data-nombre');
      const idCat = btn.getAttribute('data-id');
      const candidatos = JSON.parse(btn.getAttribute('data-candidatos') || '[]');

      if (modalTitulo) modalTitulo.textContent = `Votar: ${nombreCat}`;
      if (inputCategoria) inputCategoria.value = idCat || '';

      if (listaCandidatos) {
        listaCandidatos.innerHTML = candidatos.map((candidato: string) => `
          <label class="opcion-radio">
            <input type="radio" name="piloto" value="${candidato}" required />
            <span>${candidato}</span>
          </label>
        `).join('');
      }

      if (inputOtroNombre) { inputOtroNombre.value = ''; inputOtroNombre.disabled = true; }
      if (radioOtro) radioOtro.checked = false;

      modal?.classList.remove('oculto');
    });
  });

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.name === 'piloto') {
      if (target.value === 'OTRO') {
        inputOtroNombre.disabled = false; inputOtroNombre.focus();
      } else {
        inputOtroNombre.disabled = true; inputOtroNombre.value = '';
      }
    }
  });

  btnCerrar?.addEventListener('click', () => modal?.classList.add('oculto'));

  // EL ENVÍO REAL A LA BASE DE DATOS TURSO
  formVoto?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btnSubmit = formVoto.querySelector('.btn-enviar-voto') as HTMLButtonElement;
    btnSubmit.textContent = 'Enviando...';
    btnSubmit.disabled = true;

    const formData = new FormData(formVoto);
    let pilotoVotado = formData.get('piloto') as string;
    if (pilotoVotado === 'OTRO') pilotoVotado = inputOtroNombre.value.trim() || 'Desconocido';
    const categoria = formData.get('categoria') as string;

    try {
      const res = await fetch('/api/votar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categoria, piloto: pilotoVotado })
      });

      if (res.ok) {
        alert(`¡Listo! Tu voto para ${pilotoVotado} fue guardado.`);
        modal?.classList.add('oculto');
        formVoto.reset();
      } else {
        alert('Hubo un problema. Intentá de nuevo.');
      }
    } catch (error) {
      alert('Error de conexión.');
    } finally {
      btnSubmit.textContent = 'Enviar Voto';
      btnSubmit.disabled = false;
    }
  });
</script>

<style>
  .piloto-contenedor { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem 4rem 1.5rem; color: #ffffff; font-family: 'Inter', sans-serif; }
  .piloto-header { text-align: center; margin-bottom: 3rem; }
  .piloto-header h1 { font-family: 'Rajdhani', sans-serif; font-size: 2.8rem; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 1px; }
  .piloto-header p { color: #a0a0a0; font-size: 1.1rem; margin: 0; }
  .categorias-grilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem; }
  .categoria-card { background-color: #121212; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s ease, border-color 0.2s ease; }
  .categoria-card:hover { transform: translateY(-4px); border-color: rgba(255, 255, 255, 0.3); }
  .casco-contenedor { height: 180px; background: linear-gradient(145deg, #1f1f1f, #111111); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid rgba(255, 255, 255, 0.05); position: relative; }
  .casco-grafico { width: 120px; height: 120px; border-radius: 50%; background: #1a1a1a; border: 2px solid #e10600; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(225, 6, 0, 0.2); }
  .siglas-cat { font-family: 'Rajdhani', sans-serif; font-size: 2rem; font-weight: 800; color: #ffffff; letter-spacing: 2px; }
  .categoria-info { padding: 1.5rem; text-align: center; display: flex; flex-direction: column; flex: 1; }
  .categoria-info h3 { font-family: 'Rajdhani', sans-serif; font-size: 1.6rem; margin: 0 0 0.2rem 0; text-transform: uppercase; }
  .subtitulo { color: #a0a0a0; font-size: 0.85rem; margin-bottom: 1.5rem; }
  .btn-votar { background-color: #e10600; color: #ffffff; border: none; padding: 0.8rem 1.5rem; border-radius: 6px; font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: background-color 0.2s ease, transform 0.1s ease; }
  .btn-votar:hover { background-color: #ff1810; }
  .modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(5px); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem; }
  .modal-overlay.oculto { display: none; }
  .modal-caja { background: #181818; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 12px; width: 100%; max-width: 480px; padding: 2rem; position: relative; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); }
  .modal-cerrar { position: absolute; top: 1rem; right: 1.2rem; background: transparent; border: none; color: #a0a0a0; font-size: 1.2rem; cursor: pointer; }
  .modal-caja h2 { font-family: 'Rajdhani', sans-serif; font-size: 1.8rem; margin: 0 0 0.3rem 0; text-transform: uppercase; }
  .modal-bajada { color: #a0a0a0; font-size: 0.95rem; margin-bottom: 1.5rem; }
  .candidatos-opciones { display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1rem; }
  .opcion-radio { display: flex; align-items: center; gap: 0.8rem; background: #222222; padding: 0.8rem 1rem; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.05); cursor: pointer; transition: border-color 0.2s ease, background 0.2s ease; }
  .opcion-radio:hover { border-color: rgba(255, 255, 255, 0.3); background: #282828; }
  .opcion-radio input[type="radio"] { accent-color: #e10600; width: 18px; height: 18px; }
  .otro-label { margin-bottom: 1.5rem; flex-wrap: wrap; }
  .otro-label input[type="text"] { flex: 1; background: #121212; border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; padding: 0.4rem 0.8rem; border-radius: 4px; font-size: 0.9rem; }
  .otro-label input[type="text"]:disabled { opacity: 0.4; }
  .btn-enviar-voto { width: 100%; background: #e10600; color: #fff; border: none; padding: 0.9rem; border-radius: 6px; font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; text-transform: uppercase; cursor: pointer; }
  .btn-enviar-voto:hover { background: #ff1810; }
</style>