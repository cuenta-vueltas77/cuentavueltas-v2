---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";

// 1. OBLIGATORIO PARA PÁGINAS ESTÁTICAS (Agregué las nuevas del CMS por las dudas)
export function getStaticPaths() {
  return [
    { params: { slug: "tc-austral" } },
    { params: { slug: "tc-patagonico" } },
    { params: { slug: "r12" } },
    { params: { slug: "tp-gol" } },
    { params: { slug: "tp1100" } },
    { params: { slug: "automovilismo" } },
    { params: { slug: "general" } },
  ];
}

const { slug } = Astro.params;

// 2. Mapeo de categorías para mantener tus nombres oficiales
const listaCategorias = [
  { slug: "tc-austral", nombre: "TC Austral" },
  { slug: "tc-patagonico", nombre: "TC Patagónico" },
  { slug: "r12", nombre: "Monomarca R12" },
  { slug: "tp-gol", nombre: "TP Gol" },
  { slug: "tp1100", nombre: "TP 1100" },
  { slug: "automovilismo", nombre: "Automovilismo" },
  { slug: "general", nombre: "General" },
];

const categoria = listaCategorias.find((c) => c.slug === slug) || {
  slug: String(slug),
  nombre: String(slug).toUpperCase(),
};

// 3. Solo traemos las notas de Markdown (Decap CMS)
const notasMD = await getCollection("noticias").catch(() => []);

// 4. Armamos la lista
const todasLasNotas = notasMD.map((nota) => ({
  id: nota.id || nota.slug,
  data: {
    titulo: nota.data.titulo,
    imagen: nota.data.imagen,
    categorias: Array.isArray(nota.data.categorias)
      ? nota.data.categorias
      : [nota.data.categorias || "General"],
    tipo: nota.data.tipo || "Noticia",
    fecha: (nota.data.fecha && !isNaN(new Date(nota.data.fecha).getTime())) 
      ? new Date(nota.data.fecha) 
      : new Date(),
  },
}));

// 5. FILTRO A PRUEBA DE BALAS: Ignora mayúsculas, espacios y guiones para que siempre coincida
const normalizar = (texto) => String(texto).toLowerCase().replace(/\s+/g, '').replace(/-/g, '');

const noticiasDeCategoria = todasLasNotas
  .filter((noticia) =>
    noticia.data.categorias.some(
      (cat) => normalizar(cat) === normalizar(categoria.slug)
    )
  )
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<!-- TU HTML EXACTO AL 100% -->
<BaseLayout titulo={categoria.nombre}>
  <section class="seccion-noticias">
    <div class="seccion-noticias__encabezado">
      <h1>{categoria.nombre}</h1>
    </div>

    {
      noticiasDeCategoria.length > 0 ? (
        <div class="news-grid">
          {
            noticiasDeCategoria.map((noticia) => (
              <NewsCard
                titulo={noticia.data.titulo}
                imagen={noticia.data.imagen}
                categoria={categoria.slug}
                tipo={noticia.data.tipo}
                fecha={noticia.data.fecha}
                url={`/noticias/${noticia.id}`}
              />
            ))
          }
        </div>
      ) : (
        <p class="mensaje-vacio">
          Todavía no hay noticias publicadas en esta categoría.
        </p>
      )
    }
  </section>
</BaseLayout>