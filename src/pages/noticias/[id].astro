---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/article.css";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets"; 

export async function getStaticPaths() {
  // 1. Buscamos todas las notas de Decap CMS (Markdown)
  const notasMD = await getCollection("noticias");
  
  // 2. Armamos las rutas
  const rutas = notasMD.map((nota) => ({
    params: { id: String(nota.id || nota.slug) },
    props: { nota }, // Le pasamos la nota entera a la página
  }));

  return rutas;
}

// Recibimos la nota directamente por las props (mucho más rápido)
const { nota } = Astro.props;

if (!nota) {
  return Astro.redirect("/404");
}

// Renderizamos el cuerpo de la noticia
const { Content } = await render(nota);

// Extraemos los datos del panel CMS
const titulo = nota.data.titulo;
const bajada = nota.data.bajada;
const imagenUrl = nota.data.imagen;
const creditoImagen = nota.data.credito_imagen;
const audioUrl = nota.data.audio || null; // Soporte para los audios de la Fase 1
const galeria = nota.data.galeria || [];

// Tomamos la categoría principal para la navegación
const categoria = Array.isArray(nota.data.categorias) 
  ? nota.data.categorias[0] 
  : (nota.data.categorias || 'Automovilismo');

// 👇 TOMAMOS LA FECHA DE LA DB Y LA CONVERTIMOS PERFECTO 👇
const fechaCruda = nota.data.fecha;
let fechaFormateada = "";

if (fechaCruda) {
  const timestamp = Number(fechaCruda);
  const fechaObj = !isNaN(timestamp) ? new Date(timestamp) : new Date(fechaCruda);

  if (!isNaN(fechaObj)) {
    const dia = fechaObj.getUTCDate();
    const meses = ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC"];
    const mes = meses[fechaObj.getUTCMonth()];
    const anio = fechaObj.getUTCFullYear();
    
    fechaFormateada = `${dia} DE ${mes} DE ${anio}`;
  } else {
    fechaFormateada = fechaCruda; 
  }
}
---

<!-- TU LAYOUT Y ESTILOS ORIGINALES INTACTOS -->
<BaseLayout
  titulo={titulo}
  bajada={bajada}
  imagen={imagenUrl}
>
  <article class="nota">
    <header class="nota__encabezado">
      <nav class="nota__migas">
      </nav>
      
      <!-- 👇 ACÁ PONEMOS LA FECHA YA LIMPIA Y FORMATEADA 👇 -->
      {fechaFormateada && (
        <span class="nota__fecha">{fechaFormateada}</span>
      )}

      <h1 class="nota__titulo">
        {titulo}
      </h1>

      <p class="nota__bajada">
        {bajada}
      </p>
    </header>

    {imagenUrl && (
      <img
        class="nota__imagen-principal"
        src={imagenUrl}
        alt={titulo}
      />
    )}

         <!-- CREDITOS -->
    {creditoImagen&& (
      <p style="text-align: right; max-width: 750px; margin: -35px auto 40px; font-size: 0.85rem; color: #888; font-family: 'Inter', sans-serif;">
        {creditoImagen}
      </p>
    )}
  
    <!-- DIBUJAMOS EL CONTENIDO DEL PANEL CMS -->
    <div class="nota__contenido" style="white-space: pre-wrap;">
       <Content />
    </div>

    <!-- REPRODUCTOR DE AUDIO OPCIONAL -->
    {audioUrl && (
      <div style="margin: 20px 0;">
        <audio controls src={audioUrl} style="width: 100%;"></audio>
      </div>
    )}

    <!-- 📲 BOTONES PARA COMPARTIR LA NOTA -->
    <div class="nota__compartir">
      <span>Compartir nota:</span>
      <div class="nota__compartir-botones">
        
        <!-- Botón WhatsApp -->
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(
            `¡Mirá esta nota en Cuenta Vueltas 77! ${titulo} - ${Astro.url.href}`
          )}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-compartir btn-wsp"
          title="Compartir en WhatsApp"
        >
          <svg class="icono-logo" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </a>

        <!-- Botón Facebook -->
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-compartir btn-fb"
          title="Compartir en Facebook"
        >
          <svg class="icono-logo" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        <!-- Botón X -->
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(
            `${titulo}`
          )}&url=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-compartir btn-tw"
          title="Compartir en X"
        >
          <svg class="icono-logo" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        
        <!-- Botón Instagram -->
        <button
          type="button"
          class="btn-compartir btn-ig"
          title="Compartir en Instagram"
          id="btn-ig-share"
        >
          <svg class="icono-logo" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- 📷 GALERÍA DE FOTOS CORREGIDA Y BLINDADA DEFINITIVA -->
    {galeria.length > 0 && (
      <section class="nota__galeria">
        <h3 class="nota__galeria-titulo">Galería de fotos</h3>
        <div class="nota__galeria-grilla">
          {galeria.map((item) => {
            // El radar: detecta la ruta exacta sin importar cómo la guarde el CMS
            const rutaFoto = typeof item === 'string' ? item : item.foto;
            
            return rutaFoto ? (
              <img
                src={rutaFoto}
                alt={`Foto de galería - ${titulo}`}
                class="foto-clickable"
                width="800"
                height="533"
                loading="lazy"
              />
            ) : null;
          })}
        </div>
      </section>
    )}

    <!-- 🔍 MODAL LIGHTBOX -->
    <div id="lightbox" class="lightbox">
      <span id="lightbox-close" class="lightbox__close">&times;</span>
      <span id="lightbox-prev" class="lightbox__nav lightbox__prev">&#10094;</span>
      <img id="lightbox-img" class="lightbox__img" src="" alt="Zoom foto" />
      <span id="lightbox-next" class="lightbox__nav lightbox__next">&#10095;</span>
    </div>
  </article>
</BaseLayout>

<!-- LOS SCRIPTS PARA INSTAGRAM Y LA GALERIA -->
<script>
  const btnIg = document.getElementById('btn-ig-share');
  if (btnIg) {
    btnIg.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href
          });
        } catch (err) {
          console.log('El usuario canceló o hubo un error:', err);
        }
      } else {
        alert('Tu navegador no soporta compartir directamente a Instagram.');
      }
    });
  }
</script>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxClose = document.getElementById("lightbox-close");
  const btnPrev = document.getElementById("lightbox-prev");
  const btnNext = document.getElementById("lightbox-next");
  
  const fotos = document.querySelectorAll(".foto-clickable");
  const arrayFotos = Array.from(fotos) as HTMLImageElement[];
  let indiceActual = 0;

  function mostrarFoto(index: number) {
    if (arrayFotos.length === 0 || !lightboxImg) return;
    
    if (index < 0) {
      indiceActual = arrayFotos.length - 1;
    } else if (index >= arrayFotos.length) {
      indiceActual = 0;
    } else {
      indiceActual = index;
    }
    
    lightboxImg.src = arrayFotos[indiceActual].src;
  }

  arrayFotos.forEach((foto, index) => {
    foto.addEventListener("click", () => {
      if (lightbox) {
        indiceActual = index;
        mostrarFoto(indiceActual);
        lightbox.classList.add("activo");
      }
    });
  });

  btnPrev?.addEventListener("click", (e) => {
    e.stopPropagation();
    mostrarFoto(indiceActual - 1);
  });

  btnNext?.addEventListener("click", (e) => {
    e.stopPropagation();
    mostrarFoto(indiceActual + 1);
  });

  lightboxClose?.addEventListener("click", () => {
    lightbox?.classList.remove("activo");
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) {
      lightbox.classList.remove("activo");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("activo")) return;

    if (e.key === "Escape") {
      lightbox.classList.remove("activo");
    } else if (e.key === "ArrowLeft") {
      mostrarFoto(indiceActual - 1);
    } else if (e.key === "ArrowRight") {
      mostrarFoto(indiceActual + 1);
    }
  });
</script>