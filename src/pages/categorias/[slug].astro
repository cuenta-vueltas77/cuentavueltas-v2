---
export const prerender = false; // 1. OBLIGATORIO: Lee de Astro DB en vivo

import { getCollection } from "astro:content";
import { db, Noticias } from "astro:db";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";

// 2. Tomamos el slug de la URL (ej: "tp1100", "r12")
const { slug } = Astro.params;

// 3. Mapeo de categorías para mantener tus nombres oficiales intactos
const listaCategorias = [
  {
    slug: "tc-austral",
    nombre: "TC Austral",
  },
  {
    slug: "tc-patagonico",
    nombre: "TC Patagónico",
  },
  {
    slug: "r12",
    nombre: "Monomarca R12",
  },
  {
    slug: "tp-gol",
    nombre: "TP Gol",
  },
  {
    slug: "tp1100",
    nombre: "TP 1100",
  },
];

// Buscamos la categoría actual en la lista (o creamos un fallback por si acaso)
const categoria = listaCategorias.find((c) => c.slug === slug) || {
  slug: String(slug),
  nombre: String(slug).toUpperCase(),
};

// 4. Traemos las notas nuevas de Astro DB y las viejas de Markdown
const notasDB = await db.select().from(Noticias).all();
const notasMD = await getCollection("noticias");

// 5. UNIFICACIÓN HÍBRIDA: Armamos una sola lista
const todasLasNotas = [
  // A) Notas de Astro DB
  ...notasDB.map((nota) => ({
    id: String(nota.id),
    data: {
      titulo: nota.titulo,
      imagen: nota.imagenUrl,
      categorias: Array.isArray(nota.categorias)
        ? nota.categorias
        : [nota.categorias || "general"],
      tipo: nota.tipo || "nota",
      fecha: (nota.fecha && !isNaN(new Date(nota.fecha).getTime())) 
  ? new Date(nota.fecha) 
  : new Date(),
    },
  })),
  // B) Notas de Markdown viejo
  ...notasMD.map((nota) => ({
    id: nota.id || nota.slug,
    data: {
      titulo: nota.data.titulo,
      imagen: nota.data.imagen,
      categorias: Array.isArray(nota.data.categorias)
        ? nota.data.categorias
        : [nota.data.categorias || "general"],
      tipo: nota.data.tipo || "nota",
      fecha: (nota.fecha && !isNaN(new Date(nota.fecha).getTime())) 
  ? new Date(nota.fecha) 
  : new Date(),
    },
  })),
];

// 6. Filtramos por la categoría actual y ordenamos de más NUEVA a más VIEJA
const noticiasDeCategoria = todasLasNotas
  .filter((noticia) =>
    noticia.data.categorias.some(
      (cat) => String(cat).toLowerCase() === String(categoria.slug).toLowerCase()
    )
  )
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<!-- TU HTML EXACTO AL 100% (Sin tocar ni una clase ni un ternary) -->
<BaseLayout titulo={categoria.nombre}>
  <section class="seccion-noticias">
    <div class="seccion-noticias__encabezado">
      <h1>{categoria.nombre}</h1>
    </div>

    {
      noticiasDeCategoria.length > 0 ? (
        <div class="news-grid">
          {
            noticiasDeCategoria.map((noticia) => (
              <NewsCard
                titulo={noticia.data.titulo}
                imagen={noticia.data.imagen}
                categoria={categoria.slug}
                tipo={noticia.data.tipo}
                fecha={noticia.data.fecha}
                url={`/noticias/${noticia.id}`}
              />
            ))
          }
        </div>
      ) : (
        <p class="mensaje-vacio">
          Todavía no hay noticias publicadas en esta categoría.
        </p>
      )
    }
  </section>
</BaseLayout>