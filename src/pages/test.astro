---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../components/NewsCard.astro";

const noticias = await getCollection("noticias");
---

<BaseLayout titulo="Noticias">
  <section class="seccion-noticias">
    <h1>Últimas noticias</h1>

    <p>Cantidad de noticias encontradas: {noticias.length}</p>

    <div class="news-grid">
      {
        noticias.map((noticia) => (
          <NewsCard
            titulo={noticia.data.titulo}
            imagen={noticia.data.imagen}
            categoria={noticia.data.categorias[0]}
            tipo={noticia.data.tipo}
            fecha={noticia.data.fecha}
            url={`/noticias/${noticia.id}`}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>